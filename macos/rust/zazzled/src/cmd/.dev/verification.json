    {
      "id": "edit-safety",
      "title": "Checked, confined, atomic edits",
      "summary": "Unit tests in edit.rs check every refusal and the write path; the invoker's smoke test repeats the sha requirement, confinement and stdin end to end.",
      "subject": [
        {
          "path": "macos/rust/zazzled/src/cmd/.dev/feature.json",
          "entityId": "safe-edits"
        },
        {
          "path": "macos/rust/zazzled/src/cmd/.dev/use-case.json",
          "entityId": "edit-a-file-safely"
        }
      ],
      "criteria": [
        "Paths outside the working directory are refused, whether given directly, through .. or through a symlink; a symlink to a file inside is edited on the real file.",
        "Every edit except --create needs --expect or --at, and a stale sha or anchor is refused without writing or revealing the current one.",
        "A file changed between loading and writing is not overwritten.",
        "CRLF files stay CRLF; permissions and hard links are kept; a failed write leaves no temporary file.",
        "An edit drops the cached record, so the next read shows the new content."
      ],
      "checks": [
        {
          "type": "automated",
          "path": "macos/rust/zazzled/src/cmd/edit.rs",
          "symbol": "test_confinement",
          "command": "cargo test -p zazzled (in macos/rust)"
