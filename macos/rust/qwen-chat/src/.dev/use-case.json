  "entities": [
    {
      "id": "chat-locally",
      "name": "Chat with Qwen3.5-9B in the terminal",
      "description": "A developer starts qwen-chat and holds a conversation with the model running on their own machine.",
      "sources": [
        {
          "path": "macos/rust/qwen-chat/src/main.rs",
          "symbol": "repl"
        }
      ],
      "actor": "Developer",
      "goal": "Get answers from a capable language model without sending anything to a hosted service.",
      "preconditions": [
        "qwen-chat is built.",
        "The machine has about 7 GB of free memory, and the weights are cached or Hugging Face is reachable."
      ],
      "postconditions": [
        "Nothing of the conversation is kept after the program exits."
      ],
      "flow": [
        {
          "id": "start",
          "actor": "Developer",
          "action": "Runs `qwen-chat`, optionally with `--think` or `-s`.",
          "sources": [
            {
              "path": "macos/rust/qwen-chat/src/main.rs",
              "symbol": "Args"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/developer.md"
        },
        {
          "id": "weights",
          "actor": "qwen-chat",
          "action": "Finds the weights in the cache folder, or downloads them with resume and retries and checks their SHA-256.",
          "sources": [
            {
              "path": "macos/rust/qwen-chat/src/download.rs",
              "symbol": "ensure"
            },
            {
              "path": "macos/rust/qwen-chat/src/download.rs",
              "symbol": "fetch_with_retries"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "load",
          "actor": "qwen-chat",
