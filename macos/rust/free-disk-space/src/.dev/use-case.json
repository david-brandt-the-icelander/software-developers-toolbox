          "action": "Below the threshold, runs clean --apply on the targets.",
          "sources": [
            {
              "path": "macos/rust/free-disk-space/src/daemon.rs",
              "symbol": "cmd_run"
            },
            {
              "path": "macos/rust/free-disk-space/src/clean.rs",
