      "actor": "Developer",
      "goal": "Stop identical copies of the same file taking space more than once.",
      "preconditions": [
        "A scan has recorded file names in the state file.",
        "The developer is on a Mac with an APFS volume."
      ],
      "postconditions": [
        "Each replaced duplicate is a clone of the kept copy, with its own metadata, and marked cloned in the state file.",
        "The developer has seen the upper bound on savings and the free-space change."
