    {
      "id": "keep-space-free",
      "name": "Keep free space above a threshold",
      "description": "The developer installs the daemon once; from then on it cleans whenever free space runs low.",
      "sources": [
        {
          "path": "macos/rust/free-disk-space/src/daemon.rs",
          "symbol": "cmd_install"
        },
        {
          "path": "macos/rust/free-disk-space/src/daemon.rs",
          "symbol": "run_loop"
        }
      ],
      "actor": "Developer",
      "goal": "Never run out of disk space because caches and build output piled up.",
      "preconditions": [
        "The developer is on a Mac, logged in, and has chosen the targets the daemon may delete."
      ],
      "postconditions": [
        "A login item runs daemon run with the chosen settings now and at every login.",
        "Whenever a check finds free space below the threshold, the targets are cleaned and the log says so."
      ],
      "flow": [
        {
          "id": "install",
          "actor": "Developer",
          "action": "Runs daemon install, optionally with --threshold, --cadence, --targets and --dev-root.",
          "sources": [
            {
              "path": "macos/rust/free-disk-space/src/main.rs",
              "symbol": "DaemonOpts"
            }
          ],
          "participantKind": "actor",
          "actorDocument": "Actors/developer.md"
        },
        {
          "id": "register",
          "actor": "free-disk-space",
          "action": "Writes the plist with its own path and the settings, boots out any earlier instance, bootstraps the new one and prints the settings and the log path.",
          "sources": [
            {
              "path": "macos/rust/free-disk-space/src/daemon.rs",
              "symbol": "cmd_install"
            },
            {
              "path": "macos/rust/free-disk-space/src/daemon.rs",
              "symbol": "plist"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "check",
          "actor": "free-disk-space",
          "action": "Every cadence of awake time, compares free space with the threshold and logs the result.",
          "sources": [
            {
              "path": "macos/rust/free-disk-space/src/daemon.rs",
              "symbol": "run_loop"
            },
            {
              "path": "macos/rust/free-disk-space/src/daemon.rs",
              "symbol": "check"
            }
          ],
          "participantKind": "system"
        },
        {
          "id": "clean",
