    {
      "id": "indexed-search-equals-scan",
      "title": "Indexed search equals a full scan",
      "summary": "Whatever the index does, a search returns what a cold full scan returns.",
      "subject": [
        { "path": "macos/rust/agent-fs/src/.dev/feature.json", "entityId": "indexed-search" },
        { "path": "macos/rust/agent-fs/src/.dev/TriIndex.state-diagram.json" }
      ],
      "criteria": [
        "Indexed searches equal full scans across edits, additions and deletions, for literal, case-insensitive, alternation and literal-free patterns",
        "The first search skips the index and later ones use it with equal results",
        "A disabled index and an index that overflows mid-search both fall back to a full scan",
        "Candidates are the files holding all trigrams, always-scan files and nothing binary",
        "Changed files are re-read, removed files vanish and compaction keeps results intact",
        "Literals give a plan; short, wildcard-led, empty and too-many-alternative patterns give none"
      ],
      "checks": [
        { "type": "automated", "path": "macos/rust/agent-fs/src/engine.rs", "symbol": "tests::test_indexed_search_matches_full_scan", "command": "cargo test -p agent-fs" },
