    {
      "id": "result-cache",
      "title": "Result cache and invalidation",
      "summary": "Cached results are reused only while every stamp is equal and was trusted, and edits invalidate them.",
      "subject": [
        { "path": "macos/rust/agent-fs/src/.dev/feature.json", "entityId": "cached-queries" },
        { "path": "macos/rust/agent-fs/src/.dev/decisions.json", "entityId": "racy-window" }
      ],
      "criteria": [
        "Search results are cached once files are old, and edits invalidate the cache",
        "Only a stamp that is old enough, and still equal, makes a cached result a hit",
        "A repeat of a delivered reply is only a marker until the content changes or fresh is asked",
        "A stamp is trusted for skipping a re-read only after it is older than the racy window",
        "The result cache, the stamp and sent tables and the index table reset at their limits; the content store evicts the oldest"
      ],
      "checks": [
