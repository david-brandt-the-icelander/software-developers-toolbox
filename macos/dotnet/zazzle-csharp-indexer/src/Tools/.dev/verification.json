      "id": "run-and-gap",
      "title": "run, its policy, and report_gap",
      "summary": "The default policy allows read-only commands and refuses editing or executing ones; run executes in the root; report_gap reaches the log.",
      "subject": [
        {
          "path": "macos/dotnet/zazzle-csharp-indexer/src/Tools/.dev/feature.json",
          "entityId": "guarded-passthrough"
        },
        {
          "path": "macos/dotnet/zazzle-csharp-indexer/src/Tools/.dev/operation.json",
          "entityId": "report-gap"
        }
      ],
      "criteria": [
        "git log, grep -rn and sed -n are allowed; sed -i, sed w, find -delete, rm, git push and git -c are refused with their reasons",
        "The unrestricted switch lifts the allowlist",
        "run executes in the root, caps output, hints at the better tool and refuses disallowed commands",
        "report_gap stores the note in the usage log in plain text"
      ],
