{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/agents/hooks/guard-git.sh"}]},
      {"matcher": "Bash|Read|Grep|Glob", "hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/agents/hooks/block-env-access.sh"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/agents/hooks/check-unpushed-work.sh", "timeout": 15}]}
    ]
  }
}
